{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["KANBAN.md", "apps/desktop/AGENTS.md"],
  "lsp": {
    "typescript": {
      "command": ["npx", "--no-install", "tsc", "--lsp", "--stdio"],
      "extensions": [".ts", ".tsx"]
    },
    "tailwindcss": {
      "command": ["npx", "--no-install", "tailwindcss-language-server", "--stdio"],
      "extensions": [".css", ".tsx"]
    }
  },
  "mcp": {
    "zai-mcp-server": {
      "type": "local",
      "command": ["npx", "--no-install", "zai-mcp-server"],
      "enabled": false,
      "environment": {
        "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:Z_AI_API_KEY}"
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:Z_AI_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "--no-install", "playwright-mcp", "--isolated"],
      "enabled": true
    },
    "zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:Z_AI_API_KEY}"
      }
    }
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 131072
  },
  "compaction": {
    "auto": true,
    "tail_turns": 4
  }
}
