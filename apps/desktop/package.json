{
  "name": "@project/desktop",
  "private": true,
  "version": "0.1.0",
  "author": "moonrock-software",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "biome check src/main src/pages src/components src/lib src/App.tsx src/api.ts src/main.tsx src/types.ts",
    "lint:fix": "biome check --write src/main src/pages src/components src/lib src/App.tsx src/api.ts src/main.tsx src/types.ts",
    "format": "biome format --write src/main src/pages src/components src/lib src/App.tsx src/api.ts src/main.tsx src/types.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project unit --project browser",
    "test:e2e": "electron-vite build && playwright test --project e2e",
    "clean": "rm -rf out dist .turbo test-results node_modules/.vite"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@project/hooks": "*",
    "@project/types": "*",
    "@project/ui": "*",
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sql.js": "^1.12.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "5.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.0"
  },
  "turborepo": {
    "tags": [
      "app"
    ]
  }
}
