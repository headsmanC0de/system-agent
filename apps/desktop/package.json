{
  "name": "@project/desktop",
  "private": true,
  "version": "0.1.0",
  "author": "moonrock-software",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project unit --project browser",
    "test:e2e": "electron-vite build && xvfb-run -a playwright test --project e2e",
    "clean": "rm -rf out dist .turbo test-results node_modules/.vite",
    "smoke": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm audit",
    "package": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@project/hooks": "*",
    "@project/types": "*",
    "@project/ui": "*",
    "@tailwindcss/vite": "^4.3.2",
    "lucide-react": "^1.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sql.js": "^1.12.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^42.6.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.4"
  },
  "turborepo": {
    "tags": [
      "app"
    ]
  },
  "description": "Desktop system manager for Arch Linux",
  "homepage": "https://moonrock.software"
}
